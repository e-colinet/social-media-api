{
  "priority": 2,
  "request": {
    "method": "POST",
    "url": "/register",
    "headers": {
      "Content-Type": "application/json"
    },
    "bodyPatterns": [
      {
        "matchesJsonPath": "$.email"
      },
      {
        "matchesJsonPath": "$.password"
      },
      {
        "matchesJsonPath": "$.name"
      }
    ]
  },
  "response": {
    "status": 201,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "success": true,
      "message": "User registered successfully",
      "data": {
        "user": {
          "id": "{{randomValue type='INT' min=1 max=1000}}",
          "name": "Demo User",
          "email": "demo@example.com",
          "email_verified_at": null,
          "created_at": "{{now}}",
          "updated_at": "{{now}}"
        },
        "token": "eyJ0eXAiOiJKV1QiLCJhbGciOiJSUzI1NiJ9.eyJhdWQiOiIxIiwianRpIjoiYWJjZGVmZ2hpamtsbW5vcCIsImlhdCI6MTYzMjQ4NzIwMCwiZXhwIjoxNjMyNTczNjAwLCJzdWIiOiIxIiwic2NvcGVzIjpbXX0.mock-token",
        "token_type": "Bearer",
        "expires_at": "{{now.timestamp}}"
      }
    }
  }
}