{
  "priority": 3,
  "request": {
    "method": "DELETE",
    "urlPattern": "/social-media-profiles/\\d+",
    "headers": {
      "Authorization": {
        "matches": "Bearer .*"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "success": true,
      "message": "Social media profile deleted successfully"
    }
  }
}