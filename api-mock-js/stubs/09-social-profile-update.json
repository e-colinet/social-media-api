{
  "priority": 3,
  "request": {
    "method": "PUT",
    "urlPattern": "/social-media-profiles/\\d+",
    "headers": {
      "Authorization": {
        "matches": "Bearer .*"
      },
      "Content-Type": "application/json"
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "success": true,
      "message": "Social media profile updated successfully",
      "data": {
        "id": "{{request.pathSegments.1}}",
        "user_id": 1,
        "platform": "twitter",
        "username": "updated_username",
        "profile_url": "https://twitter.com/updated_username",
        "follower_count": 1350,
        "following_count": 920,
        "bio": "Updated bio for demo profile",
        "avatar_url": "https://pbs.twimg.com/profile_images/updated.jpg",
        "is_verified": false,
        "is_active": true,
        "last_sync_at": "{{now}}",
        "created_at": "2024-01-01T00:00:00.000000Z",
        "updated_at": "{{now}}"
      }
    }
  }
}