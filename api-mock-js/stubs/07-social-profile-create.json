{
  "priority": 3,
  "request": {
    "method": "POST",
    "url": "/social-media-profiles",
    "headers": {
      "Authorization": {
        "matches": "Bearer .*"
      },
      "Content-Type": "application/json"
    },
    "bodyPatterns": [
      {
        "matchesJsonPath": "$.platform"
      },
      {
        "matchesJsonPath": "$.username"
      }
    ]
  },
  "response": {
    "status": 201,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "success": true,
      "message": "Social media profile created successfully",
      "data": {
        "id": "{{randomValue type='INT' min=10 max=1000}}",
        "user_id": 1,
        "platform": "linkedin",
        "username": "demo-user",
        "profile_url": "https://linkedin.com/in/demo-user",
        "follower_count": 0,
        "following_count": 0,
        "bio": null,
        "avatar_url": null,
        "is_verified": false,
        "is_active": true,
        "last_sync_at": null,
        "created_at": "{{now}}",
        "updated_at": "{{now}}"
      }
    }
  }
}