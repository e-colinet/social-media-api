{
  "priority": 2,
  "request": {
    "method": "POST",
    "url": "/auth/login",
    "headers": {
      "Content-Type": "application/json"
    },
    "bodyPatterns": [
      {
        "matchesJsonPath": "$.email"
      },
      {
        "matchesJsonPath": "$.password"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "success": true,
      "message": "Login successful",
      "data": {
        "user": {
          "id": 1,
          "name": "Demo User",
          "email": "demo@example.com",
          "email_verified_at": "{{now}}",
          "created_at": "2024-01-01T00:00:00.000000Z",
          "updated_at": "{{now}}"
        },
        "token": "eyJ0eXAiOiJKV1QiLCJhbGciOiJSUzI1NiJ9.eyJhdWQiOiIxIiwianRpIjoiYWJjZGVmZ2hpamtsbW5vcCIsImlhdCI6MTYzMjQ4NzIwMCwiZXhwIjoxNjMyNTczNjAwLCJzdWIiOiIxIiwic2NvcGVzIjpbXX0.mock-token-login",
        "token_type": "Bearer",
        "expires_at": "{{now.timestamp}}"
      }
    }
  }
}