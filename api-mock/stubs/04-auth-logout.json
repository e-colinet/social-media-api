{
  "priority": 2,
  "request": {
    "method": "POST",
    "url": "/auth/logout",
    "headers": {
      "Authorization": {
        "matches": "Bearer .*"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "success": true,
      "message": "Successfully logged out"
    }
  }
}