{
  "priority": 4,
  "request": {
    "method": "GET",
    "urlPattern": "/social-media-profiles/platform/\\w+",
    "headers": {
      "Authorization": {
        "matches": "Bearer .*"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "success": true,
      "data": [
        {
          "id": 1,
          "user_id": 1,
          "platform": "{{request.pathSegments.2}}",
          "username": "demo_user_{{request.pathSegments.2}}",
          "profile_url": "https://{{request.pathSegments.2}}.com/demo_user_{{request.pathSegments.2}}",
          "follower_count": "{{randomValue type='INT' min=100 max=10000}}",
          "following_count": "{{randomValue type='INT' min=50 max=5000}}",
          "bio": "Demo {{request.pathSegments.2}} profile",
          "avatar_url": "https://{{request.pathSegments.2}}.com/avatar.jpg",
          "is_verified": false,
          "is_active": true,
          "last_sync_at": "{{now}}",
          "created_at": "2024-01-01T00:00:00.000000Z",
          "updated_at": "{{now}}"
        }
      ],
      "meta": {
        "platform": "{{request.pathSegments.2}}",
        "total": 1
      }
    }
  }
}