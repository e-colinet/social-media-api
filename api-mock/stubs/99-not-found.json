{
  "priority": 0,
  "request": {
    "method": "GET",
    "urlPattern": ".*"
  },
  "response": {
    "status": 404,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "success": false,
      "error": "Not Found",
      "message": "The requested endpoint {{request.method}} {{request.url}} was not found",
      "timestamp": "{{now}}"
    }
  }
}